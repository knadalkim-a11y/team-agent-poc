# $env:CORP_PROXY_URL = "http://실제-프록시-주소:포트"
# $env:CORP_NO_PROXY = "127.0.0.1,localhost,실제-vLLM-호스트"

CORP_PROXY_URL=http://proxy.company.example:8080
CORP_NO_PROXY=127.0.0.1,localhost,vllm.company.internal
OPENWEBUI_BASE_URL=http://127.0.0.1:8080

