@@ -0,0 +1,271 @@
+<script lang="ts">
+	import { getContext, onDestroy, tick } from 'svelte';
+	import { page } from '$app/stores';
+	import { user } from '$lib/stores';
+	import { createNewPrompt, getPrompts } from '$lib/apis/prompts';
+	import { toast } from 'svelte-sonner';
+	import Dropdown from '../common/Dropdown.svelte';
+	import Modal from '../common/Modal.svelte';
+	import PromptEditor from '../workspace/Prompts/PromptEditor.svelte';
+	import Icon from './EesIcon.svelte';
+	import PlusAlt from '../icons/PlusAlt.svelte';
+	import { eesAction, eesSnapshot, eesSessionReady } from './state';
+
+	export let prompt = '';
+	export let chatId = '';
+	export let onChoose: (text: string) => Promise<void>;
+	const i18n: any = getContext('i18n');
+	let show = false;
+	let loading = false;
+	let error = false;
+	let query = '';
+	let items: any[] = [];
+	let listSession: any = null;
+	let showCreate = false;
+	let draft: any = null;
+	let createSession: any = null;
+	let sequence = 0;
+	let alive = true;
+	let previousBoundary = '';
+	let trigger: HTMLButtonElement;
+	$: cap = $eesSnapshot.native_capabilities ?? $eesSnapshot.state?.capabilities ?? {};
+	$: canManage =
+		cap.actor_id === $user?.id &&
+		cap.native_access_available === true &&
+		cap.native_access?.prompts === true;
+	$: boundary = JSON.stringify([
+		$user?.id,
+		$eesSessionReady,
+		chatId,
+		$page.url.pathname,
+		$page.url.search
+	]);
+	$: if (boundary !== previousBoundary) {
+		previousBoundary = boundary;
+		reset();
+	}
+	$: if (!canManage) {
+		showCreate = false;
+		draft = null;
+		createSession = null;
+	}
+	$: filtered = items.filter((item) =>
+		`${item.name || ''} ${item.command || ''} ${item.content || ''}`
+			.toLocaleLowerCase()
+			.includes(query.trim().toLocaleLowerCase())
+	);
+	$: t = (key, fallback) => $i18n.t(key, { defaultValue: fallback });
+	function session() {
+		return { boundary, actor: $user?.id, token: localStorage.token };
+	}
+	function current(at) {
+		return (
+			alive &&
+			$eesSessionReady &&
+			at?.actor &&
+			at.actor === $user?.id &&
+			at.boundary === boundary &&
+			at.token === localStorage.token
+		);
+	}
+	function reset() {
+		sequence++;
+		show = false;
+		showCreate = false;
+		loading = false;
+		error = false;
+		query = '';
+		items = [];
+		listSession = null;
+		draft = null;
+		createSession = null;
+	}
+	onDestroy(() => {
+		alive = false;
+		sequence++;
+	});
+	async function load() {
+		const at = session(),
+			request = ++sequence;
+		items = [];
+		loading = true;
+		error = false;
+		try {
+			const result = await getPrompts(at.token);
+			if (!current(at) || request !== sequence) return;
+			if (!Array.isArray(result)) throw new Error('prompts_unavailable');
+			items = result.filter(
+				(item) => item && typeof item.content === 'string' && item.is_active !== false
+			);
+			listSession = at;
+		} catch (_) {
+			if (current(at) && request === sequence) error = true;
+		} finally {
+			if (current(at) && request === sequence) loading = false;
+		}
+	}
+	function opened(open: boolean) {
+		if (open) {
+			query = '';
+			void load();
+		} else {
+			sequence++;
+			loading = false;
+		}
+	}
+	async function choose(item) {
+		if (!current(listSession) || !items.includes(item)) return;
+		show = false;
+		await onChoose(item.content);
+	}
+	async function saveInput() {
+		if (!canManage || !prompt.trim() || !$eesSessionReady) return;
+		createSession = session();
+		const at = createSession;
+		draft = { name: '', command: '', content: prompt, tags: [], access_grants: [] };
+		show = false;
+		await tick();
+		if (current(at) && canManage && draft) showCreate = true;
+	}
+	async function save(value) {
+		const at = createSession;
+		if (!canManage || !current(at)) return;
+		// Reuse Native creation and its validation/permissions; never update an existing prompt.
+		const result = await createNewPrompt(at.token, value).catch((failure) => {
+			if (current(at)) throw failure;
+		});
+		if (!current(at)) return;
+		if (!result?.id)
+			throw new Error(t('EES.Prompts.SaveFailed', 'Could not save. Your text is still here.'));
+		showCreate = false;
+		draft = null;
+		createSession = null;
+		toast.success($i18n.t('Prompt created successfully'));
+		await tick();
+		if (current(at)) trigger?.focus();
+	}
+	function listKeys(event: KeyboardEvent) {
+		if (event.key === 'Escape') {
+			// Consume this popup's Escape before Native's global chat-focus shortcut.
+			event.preventDefault();
+			event.stopPropagation();
+			show = false;
+			opened(false);
+			trigger?.focus();
+			return;
+		}
+		if (!['ArrowDown', 'ArrowUp'].includes(event.key)) return;
+		const buttons = Array.from(
+			(event.currentTarget as HTMLElement).querySelectorAll<HTMLButtonElement>('[data-saved-prompt]')
+		);
+		if (!buttons.length) return;
+		const at = buttons.indexOf(document.activeElement as HTMLButtonElement);
+		const next =
+			at < 0
+				? event.key === 'ArrowDown'
+					? 0
+					: buttons.length - 1
+				: (at + (event.key === 'ArrowDown' ? 1 : -1) + buttons.length) % buttons.length;
+		event.preventDefault();
+		buttons[next].focus();
+	}
+</script>
+
+<Dropdown
+	bind:show
+	side="top"
+	sideOffset={8}
+	anchorSelector="#message-input-container"
+	focusSelector=".ees-prompts-search"
+	contentClass="ees-assets-popover ees-prompts-popover"
+	onOpenChange={opened}
+	visualViewportAware
+>
+	<button
+		bind:this={trigger}
+		type="button"
+		id="ees-saved-prompts-button"
+		class="ees-prompts-trigger"
+		aria-expanded={show}
+		aria-haspopup="menu"
+		aria-label={t('EES.Nav.Prompts', 'Saved prompts')}
+		title={t('EES.Nav.Prompts', 'Saved prompts')}
+	>
+		<Icon name="093d6" /><span>{t('EES.Nav.Prompts', 'Saved prompts')}</span><Icon name="ead50" />
+	</button>
+	<div slot="content" on:keydown={listKeys} role="presentation">
+		<h2>{t('EES.Nav.Prompts', 'Saved prompts')}</h2>
+		<input
+			bind:value={query}
+			type="search"
+			class="ees-prompts-search"
+			aria-label={t('EES.Prompts.Search', 'Search prompts')}
+			placeholder={t('EES.Prompts.Search', 'Search prompts')}
+		/>
+		<div class="ees-prompts-list">
+			{#if loading}<p role="status">{t('EES.Loading', 'Loading…')}</p>
+			{:else if error}<p role="alert">
+					{t('EES.Prompts.LoadFailed', 'Could not load prompts.')}
+					<button type="button" on:click={load}>{t('EES.Retry', 'Check again')}</button>
+				</p>
+			{:else if !filtered.length}<p role="status">
+					{t(
+						query.trim() ? 'EES.Prompts.NoMatches' : 'EES.Prompts.Empty',
+						query.trim() ? 'No matching prompts.' : 'No saved prompts yet.'
+					)}
+				</p>
+			{:else}{#each filtered as item}
+					<button
+						type="button"
+						role="menuitem"
+						data-saved-prompt={item.id || item.command}
+						class="ees-asset-row"
+						on:click={() => choose(item)}
+					>
+						<Icon name="093d6" /><span
+							><strong>{item.name || item.command}</strong><small
+								>{item.content.replace(/\s+/g, ' ')}</small
+							></span
+						>
+					</button>
+				{/each}{/if}
+		</div>
+		{#if canManage}<footer>
+				<button
+					type="button"
+					data-save-current-prompt
+					disabled={!prompt.trim()}
+					on:click={saveInput}
+					><PlusAlt className="ew-icon" />{t('EES.Prompts.SaveInput', 'Save current input')}</button
+				>
+				<button
+					type="button"
+					data-action="native_open"
+					data-native-id="prompts"
+					on:click={() => {
+						show = false;
+						eesAction({ action: 'native_open', nativeId: 'prompts' });
+					}}>{t('EES.Prompts.Manage', 'Manage prompts')}</button
+				>
+			</footer>{/if}
+	</div>
+</Dropdown>
+
+<Modal
+	bind:show={showCreate}
+	size="full"
+	className="!w-[calc(100vw-2rem)] sm:!w-[calc(100vw-3rem)] lg:!w-[calc(100vw-4rem)] !max-w-[80rem] h-[min(54rem,calc(100dvh-4rem))] max-h-[calc(100dvh-4rem)] flex flex-col bg-white dark:bg-gray-900 rounded-4xl"
+>
+	{#if draft && canManage}<PromptEditor
+			modal
+			prompt={draft}
+			onSubmit={save}
+			onCancel={async () => {
+				showCreate = false;
+				draft = null;
+				createSession = null;
+				await tick();
+				trigger?.focus();
+			}}
+		/>{/if}
+</Modal>
diff --git a/src/lib/components/ees/EesScopeSelect.svelte b/src/lib/components/ees/EesScopeSelect.svelte
new file mode 100644
index 0000000..6e7a618
--- /dev/null
+++ b/src/lib/components/ees/EesScopeSelect.svelte
@@ -0,0 +1,193 @@
+<script lang="ts">
+	import { getContext, onDestroy, tick } from 'svelte';
+	import { eesAction } from './state';
+	import Icon from './EesIcon.svelte';
+	const i18n: any = getContext('i18n');
+	export let kind: 'factory' | 'system';
+	export let label = '';
+	export let compact = false;
+	export let value = '';
+	export let options: any[] = [];
+	export let opened = '';
+	export let boundary = '';
+	export let selectionContext = '';
+	export let exitBoundary = '';
+	let root: HTMLDivElement;
+	let trigger: HTMLButtonElement;
+	let list: HTMLDivElement;
+	let dropdown: HTMLDivElement;
+	let shown = false, scopeVersion = 0;
+	let restoreOnClose = true;
+	let pendingSelection: { value: string; context: string } | null = null;
+	let selectionExitBoundary: string | null = null;
+	let search: HTMLInputElement;
+	let query = '';
+	let previousBoundary = '';
+	$: t = (key, fallback) => $i18n.t(key, { defaultValue: fallback });
+	$: icon = kind === 'factory' ? '40095' : 'f34f3';
+	$: triggerId = kind === 'factory' ? 'ees-work-site-trigger' : 'ees-work-system-trigger';
+	$: listId = `ees-scope-${kind}-list`;
+	$: searchable = kind === 'factory' && options.filter((item) => item.id !== '').length >= 8;
+	$: visible = options.filter((item) => item.id === '' || !query.trim() || String(item.name || item.id).toLocaleLowerCase().includes(query.trim().toLocaleLowerCase()));
+	$: current = options.find((item) => item.id === value);
+	$: selectedName = current?.name || current?.id || (kind === 'factory' ? t('EES.AllFactories', 'All factories') : value || t('EES.Select', 'Select'));
+	$: syncBoundary(boundary, selectionContext, value, exitBoundary);
+	function syncBoundary(next: string, context: string, selected: string, exit: string) {
+		if (next === previousBoundary) return;
+		previousBoundary = next;
+		const ownSelection = pendingSelection?.value === selected && pendingSelection?.context === context;
+		// A system choice also replaces the sibling factory catalog, from cache
+		// or its response. Its inert exit may continue only while its own catalog,
+		// selected destination and all account/navigation fields remain unchanged.
+		const ownExit = shown && !opened && (ownSelection || selectionExitBoundary === exit);
+		selectionExitBoundary = ownExit ? exit : null;
+		pendingSelection = null;
+		if (opened === kind) close(false);
+		if (shown && !ownExit) retireScope();
+	}
+	function retireScope() {
+		pendingSelection = null;
+		selectionExitBoundary = null;
+		scopeVersion++;
+		window.__eesMotionV1?.finish(dropdown, { restoreFocus: false });
+		window.__eesMotionV1?.cancel(dropdown);
+		shown = false;
+		query = '';
+	}
+	$: syncScope(opened === kind, opened);
+	function syncScope(wantsOpen: boolean, activeKind: string) {
+		const version = ++scopeVersion;
+		if (wantsOpen) {
+			const retained = shown && dropdown;
+			shown = true;
+			pendingSelection = null;
+			selectionExitBoundary = null;
