--- /dev/null
+++ b/src/lib/components/ees/state.ts
@@ -0,0 +1,31 @@
+import { writable } from 'svelte/store';
+export const eesSnapshot = writable<any>({
+	state: null,
+	selection: { mode: 'work', tab: 'my_work', panel_open: true, collapsed: [] },
+	busy: false,
+	error: ''
+});
+export const eesHelperState = writable({ busy: false, notice: '' });
+export const eesSessionReady = writable(true);
+export const eesCompact = writable(typeof window !== 'undefined' && window.innerWidth < 1440);
+export const eesReferenceHosts = new Map<string, HTMLElement>();
+export const eesSync = () => {
+	if (typeof window !== 'undefined') window.__eesNativeWorkV1?.sync?.();
+};
+export const eesAction = (dataset: Record<string, any>) =>
+	window.__eesNativeWorkV1?.action?.(dataset);
+export function referenceSlot(node: HTMLElement, id: string) {
+	eesReferenceHosts.set(id, node);
+	eesSync();
+	return {
+		update(next: string) {
+			if (eesReferenceHosts.get(id) === node) eesReferenceHosts.delete(id);
+			id = next;
+			eesReferenceHosts.set(id, node);
+			eesSync();
+		},
+		destroy() {
+			if (eesReferenceHosts.get(id) === node) eesReferenceHosts.delete(id);
+		}
+	};
+}
