+	.ees-helper-intro {
+		max-width: 760px;
+		margin: 0 auto;
+		display: flex;
+		flex-direction: column;
+		gap: 12px;
+		color: #1f2023;
+		font-size: 14px;
+		line-height: 22px;
+		letter-spacing: -0.042px;
+	}
+	.ees-helper-label {
+		display: flex;
+		align-items: center;
+		gap: 6px;
+		font-size: 12px;
+		line-height: 16px;
+		font-weight: 500;
+		color: #5c5e65;
+	}
+	.ees-helper-avatar {
+		width: 16px;
+		height: 16px;
+		border-radius: 8px;
+		background: #eef3f9;
+		color: #2f5f98;
+		display: inline-flex;
+		align-items: center;
+		justify-content: center;
+		font-size: 10px;
+		line-height: 16px;
