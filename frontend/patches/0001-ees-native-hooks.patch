+	export let empty = false;
+	$: t = (key, fallback) => $i18n.t(key, { defaultValue: fallback });
+	const questions = [
+		[
+			'EES.Procedure.Question1',
+			'I want to copy the factory rollout example and adapt it to our factory'
+		],
+		[
+			'EES.Procedure.Question2',
+			'Explain categories and execution modes (periodic, on-demand, emergency)'
+		],
+		['EES.Procedure.Question3', 'What should I decide first when starting an empty procedure?']
+	];
+</script>
+
+{#if $eesSnapshot.procedure_start}
+	<section
+		id="ees-work-procedure-start"
+		data-ees-work
+		data-ees-procedure-intro
+		data-empty={empty}
+		class:empty
+		aria-label={t('EES.Procedure.Start', 'Start a procedure')}
+	>
+		<div class="ees-helper-intro">
+			{#if empty}
+			<div class="ees-helper-label">
+				<span class="ees-helper-avatar">{t('EES.Helper.Initial', 'W')}</span>{t(
+					'EES.Helper',
+					'Work assistant'
+				)}
+			</div>
+			<p>
+				{t(
+					'EES.Procedure.Intro',
+					'Copy a similar example and adapt it, or start with an empty procedure. Ask a question below to learn how. The assistant explains the steps; it does not create drafts from this conversation yet. Drafts appear in work only after publication.'
+				)}
+			</p>
+			{/if}
+			<EesHelperNotice />
+			<div class="ees-helper-questions" data-ees-helper-questions>
+				{#each questions as question, index}
+					<button
+						type="button"
+						data-action="procedure_question"
+						data-question-index={index}
+						disabled={$eesHelperState.busy}
+						on:click={() =>
+							eesAction({
+								action: 'procedure_question',
+								questionIndex: String(index),
+								question: t(question[0], question[1])
+							})}
+					>
+						<Icon name="cf77a" /><span>{t(question[0], question[1])}</span><Icon name="69549" />
+					</button>
+				{/each}
+			</div>
+			{#if empty}
+			<small
+				>{t(
+					'EES.Procedure.SendNow',
+					'Choose a question to send it now. The work assistant replies in this conversation; your draft and attachments stay as they are.'
+				)}</small
+			>
+			{/if}
+		</div>
+	</section>
+{/if}
+
+<style>
+	section {
+		flex: none;
+		padding: 8px 24px;
+		text-align: left;
+	}
+	section.empty {
+		padding: 32px 24px 12px;
