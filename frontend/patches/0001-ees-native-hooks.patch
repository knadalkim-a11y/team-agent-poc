+++ b/src/lib/components/ees/EesShell.svelte
@@ -0,0 +1,394 @@
+<script lang="ts">
+	import { getContext, onMount, tick } from 'svelte';
+	import { get } from 'svelte/store';
+	import { goto, afterNavigate, beforeNavigate } from '$app/navigation';
+	import { page } from '$app/stores';
+	import { eesRequest } from '$lib/apis/ees-work';
+	import { user, selectedFolder, showSettings, showSearch } from '$lib/stores';
+	import Sidebar from '$lib/components/layout/Sidebar.svelte';
+	import Chat from '$lib/components/chat/Chat.svelte';
+	import Navbar from '$lib/components/chat/Navbar.svelte';
+	import Spinner from '$lib/components/common/Spinner.svelte';
+	import {
+		eesSnapshot,
+		eesCompact,
+		eesAction,
+		eesSync,
+		eesReferenceHosts,
+		eesHelperState,
+		eesSessionReady
+	} from './state';
+	const i18n: any = getContext('i18n');
+	export let loaded = false;
+	let panel: HTMLElement, overlays: HTMLElement;
+	let mounted = false,
+		width = typeof window !== 'undefined' ? window.innerWidth : 1440;
+	let retainedChatId = $page.params.id || '',
+		hasChat = /^\/(?:c\/[^/]+\/?)?$/.test($page.url.pathname);
+	let lastChatPath: string | null = hasChat && retainedChatId ? $page.url.pathname : null;
+	let transientWidth: number | null = null;
+	let compactBreakpoint = width < 1440;
+	$: if (width < 1440 !== compactBreakpoint) {
+		compactBreakpoint = width < 1440;
+		eesCompact.set(compactBreakpoint);
+	}
+	let resizing = false,
+		dragX = 0,
+		dragWidth = 480;
+
+	const clamp = (value) => Math.max(400, Math.min(720, Math.round(Number(value) || 480)));
+	$: t = (key, fallback) => $i18n.t(key, { defaultValue: fallback });
+	$: folderRoute = /^\/folders\/[^/]+\/?$/.test($page.url.pathname);
+	$: folderReady = !folderRoute || $selectedFolder?.id === $page.params.folderId;
+	$: chatRoute = folderRoute || /^\/(?:c\/[^/]+\/?)?$/.test($page.url.pathname);
+	$: nativeRoute = !chatRoute;
+	$: admin = typeof $showSettings === 'string' && $showSettings.startsWith('admin:');
+	$: if (chatRoute && folderReady) {
+		retainedChatId = $page.params.id || '';
+		hasChat = true;
+		if (retainedChatId) lastChatPath = $page.url.pathname;
+	}
+	$: s = $eesSnapshot.selection || {};
+	$: panelWidth = transientWidth ?? ($eesSnapshot.procedure_start ? 580 : clamp(s.panel_width));
+	$: panelOpen = !nativeRoute && s.panel_open !== false;
+	$: panelOverlay =
+		width - ($eesCompact ? 56 : 256) - ($eesSnapshot.procedure_start ? 580 : 480) < 560;
+	$: if (mounted) {
+		$page.url.pathname;
+		$page.url.search;
+		$user?.id;
+		$eesSessionReady;
+		$showSettings;
+		tick().then(eesSync);
+	}
+	function clearPrivateDrafts() {
+		lastChatPath = null;
+		selectedFolder.set(null);
+		for (const key of Object.keys(sessionStorage))
+			if (key.startsWith('chat-input')) sessionStorage.removeItem(key);
+		eesSnapshot.set({
+			state: null,
+			selection: { mode: 'work', tab: 'my_work', panel_open: true, collapsed: [] }
+		});
+	}
+	function rememberOwner(id) {
+		const old = sessionStorage.getItem('ees-source-draft-owner');
+		if (old && old !== id) clearPrivateDrafts();
+		if (id) sessionStorage.setItem('ees-source-draft-owner', id);
+		else sessionStorage.removeItem('ees-source-draft-owner');
+	}
+	async function navigate(path) {
+		if (path === '/admin/settings') {
+			showSettings.set('admin:general');
+			await tick();
+			eesSync();
+			return;
+		}
+		showSettings.set(false);
+		await goto(path);
+		await tick();
+		eesSync();
+	}
+	async function newChat() {
+		showSettings.set(false);
+		selectedFolder.set(null);
+		if ($page.url.pathname !== '/') await goto('/');
+		else await window.__eesNativeDraftV1?.newChat?.();
+		await tick();
+		eesSync();
+	}
+	function setWidth(next, persist = false) {
+		transientWidth = clamp(next);
+		if (persist) {
+			eesAction({ action: 'panel_width', width: transientWidth });
+			transientWidth = null;
+		}
+	}
+	function resizeStart(e) {
+		if (e.button !== 0) return;
+		e.preventDefault();
+		// The prevented pointer event needs explicit focus for keyboard resizing.
+		e.currentTarget.focus({ preventScroll: true });
+		resizing = true;
+		dragX = e.clientX;
+		dragWidth = panelWidth;
+		e.currentTarget.setPointerCapture(e.pointerId);
+	}
+	function resizeMove(e) {
+		if (resizing) setWidth(dragWidth + dragX - e.clientX);
+	}
+	function resizeEnd() {
+		if (!resizing) return;
+		resizing = false;
+		setWidth(panelWidth, true);
+	}
+	// A direct folder route waits for Native's folder permission/selection load.
+	// Menu returns to the same folder keep the live composer untouched.
+	$: if (mounted && folderRoute && folderReady) {
+		const path = $page.url.pathname;
+		tick().then(() => {
+			if (location.pathname === path && bridge.shouldInitChat(path))
+				window.__eesNativeDraftV1?.newChat?.();
+		});
+	}
+	const bridge = {
+		request: eesRequest,
+		askHelp: (payload) => window.__eesNativeDraftV1?.askHelp?.(payload),
+		helpState: () => get(eesHelperState),
+		adoptChat: async (id) => {
+			if (window.__eesNativeDraftV1?.activeChatId?.() !== id) return;
+			retainedChatId = id;
+			lastChatPath = `/c/${id}`;
+			window.__eesNativeWorkV1?.chatCreated?.(id);
+			if (nativeRoute || admin) {
+				eesSync();
+				return;
+			}
+			await goto(lastChatPath, { replaceState: true, keepFocus: true, noScroll: true });
+			await tick();
+			eesSync();
+		},
+		retainFolder: () => nativeRoute,
+		newChatStarted: async () => {
+			selectedFolder.set(null);
+			retainedChatId = '';
+			lastChatPath = '/';
+			await goto('/', { replaceState: true, keepFocus: true, noScroll: true });
+		},
+		hosts: () => ({ panel, overlays }),
+		screen: () => ({
+			active: Boolean(get(user)) && get(eesSessionReady),
+			native: nativeRoute || admin,
+			admin,
+			chatReady:
+				get(eesSessionReady) &&
+				chatRoute &&
+				folderReady &&
+				Boolean(window.__eesNativeDraftV1?.ready?.()),
+			path: location.pathname,
+			search: location.search
+		}),
+		publish: (snapshot) => eesSnapshot.set(snapshot),
+		toggleSidebar: () => eesCompact.set(!get(eesCompact)),
+		navigate,
+		closeSettings: () => showSettings.set(false),
+		newChat,
+		searchChats: () => showSearch.set(true),
+		focusComposer: () => window.__eesNativeDraftV1?.focus?.(),
+		referenceHost: (id) => eesReferenceHosts.get(id),
+		shouldInitChat: (path) => {
+			if (
+				path.startsWith('/folders/') &&
+				get(selectedFolder)?.id !== decodeURIComponent(path.split('/')[2])
+			)
+				return false;
+			if (path === lastChatPath) return false;
+			lastChatPath = path;
+			return true;
+		}
+	};
+	if (typeof window !== 'undefined') {
+		rememberOwner($user?.id || '');
+		window.__eesSourceShellV1 = bridge;
+	}
+	// A stable Chat instance keeps live image attachments and Native composer state
+	// while source routing switches the visible region. No DOM is moved or rediscovered.
+	beforeNavigate(() => {
+		window.__eesNativeDraftV1?.flush?.();
+	});
+	afterNavigate(() => {
+		if (mounted) tick().then(eesSync);
+	});
+	onMount(() => {
+		rememberOwner($user?.id || '');
+		window.__eesSourceShellV1 = bridge;
+		mounted = true;
+		eesSync();
+		let previous = $user?.id || '';
+		const unsubscribe = user.subscribe((value) => {
+			const next = value?.id || '';
+			if (next !== previous) {
+				clearPrivateDrafts();
+				rememberOwner(next);
+				previous = next;
+				eesSync();
+			}
+		});
+		return () => {
+			unsubscribe();
+			mounted = false;
+			if (window.__eesSourceShellV1 === bridge) delete window.__eesSourceShellV1;
+		};
+	});
+</script>
+
+<svelte:window bind:innerWidth={width} />
+<div
+	data-ees-source-shell
+	data-ees-route={nativeRoute ? 'native' : 'chat'}
+	class="ees-source-shell"
+	on:pointerdown={(event) => window.__eesNativeWorkV1?.dismissHelp?.(event)}
+>
+	<Sidebar />
+	<section class="ees-center" aria-label={t('EES.Conversation', 'Conversation')}>
+		{#if !nativeRoute && (!loaded || !hasChat || !folderReady)}<Navbar
+				history={{ currentId: null }}
+				initNewChat={() => {}}
+				pending
+			/>{/if}
+		<main id="main-content" class="ees-main">
+			{#if loaded}
+				{#if hasChat}{#key $user?.id}<div
+							class="ees-chat-region"
+							hidden={nativeRoute || !folderReady}
+							inert={nativeRoute || !folderReady}
+							aria-hidden={nativeRoute || !folderReady}
+							on:input={() => window.__eesNativeWorkV1?.interaction?.()}
+							on:change={() => window.__eesNativeWorkV1?.interaction?.()}
+						>
+							<Chat chatIdProp={retainedChatId} />
+						</div>{/key}{/if}
+				{#if nativeRoute}<div class="ees-native-region" data-ees-native-surface>
+						<slot />
+					</div>{:else}<slot />{/if}
+			{:else}<div class="ees-region-loading" role="status">
+					<Spinner className="size-5" /><span>{t('EES.Loading', 'Loading…')}</span>
+				</div>{/if}
+		</main>
+	</section>
+	<section
+		class="ees-panel-region"
+		style:width={`${panelWidth}px`}
+		data-overlay={panelOverlay}
+		hidden={!panelOpen}
+		inert={!panelOpen}
+		aria-label={t('EES.Panel', 'Work panel')}
+	>
+		<div
+			class="ees-panel-resize"
+			data-ees-panel-resize
+			hidden={Boolean($eesSnapshot.procedure_start)}
+			role="separator"
+			tabindex="0"
+			aria-label={t('EES.PanelWidth', 'Work panel width')}
+			aria-orientation="vertical"
+			aria-valuemin="400"
+			aria-valuemax="720"
+			aria-valuenow={panelWidth}
+			on:pointerdown={resizeStart}
+			on:pointermove={resizeMove}
+			on:pointerup={resizeEnd}
+			on:pointercancel={() => {
+				resizing = false;
+				transientWidth = null;
+			}}
+			on:keydown={(event) => {
+				const next = {
+					ArrowLeft: panelWidth + 16,
+					ArrowRight: panelWidth - 16,
+					Home: 400,
+					End: 720
+				}[event.key];
+				if (next !== undefined) {
+					event.preventDefault();
+					setWidth(next, true);
+				}
+			}}
+		></div>
+		<aside
+			id="ees-work-panel"
+			data-ees-work
+			data-ees-source-slot
+			bind:this={panel}
+			aria-label={t('EES.Panel', 'Work panel')}
+		></aside>
+	</section>
+	<div data-ees-overlay-slot bind:this={overlays}></div>
+</div>
+
+<style>
+	.ees-source-shell {
+		display: flex;
+		position: relative;
+		width: 100%;
+		height: 100dvh;
+		min-height: 0;
+		overflow: hidden;
+		background: #fff;
+		color: #1f2023;
+	}
+	.ees-center {
+		display: flex;
+		flex: 1;
+		flex-direction: column;
+		min-width: 0;
+		min-height: 0;
+	}
+	.ees-main,
+	.ees-chat-region,
+	.ees-native-region {
+		flex: 1;
+		width: 100%;
+		height: 100%;
+		min-height: 0;
+		min-width: 0;
+		overflow: hidden;
