+<script lang="ts">
+	import { getContext } from 'svelte';
+	import { eesSnapshot, eesAction, eesHelperState } from './state';
+	import Icon from './EesIcon.svelte';
+	import EesHelperNotice from './EesHelperNotice.svelte';
