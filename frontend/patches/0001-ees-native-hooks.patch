+						aria-current={s.tab === action ? 'page' : undefined}
+						on:click={() => {
+							if (action === 'chats') eesCompact.set(false);
+							eesAction({ action });
+						}}
+						><Icon name={icon} /><span>{t(key, label)}</span
+						>{#if action === 'my_work' && data.my_work?.length}<small>{data.my_work.length}</small
+							>{/if}</button
+					>{/each}
+			</nav>
+			<p class="ew-nav-caption">{t('EES.Nav.Work', 'Work')}</p>
+			<nav class="ew-workflows">
+				{#each groups as [id, icon, key, label]}<details
+						data-category={id}
+						open={!s.collapsed?.includes(id)}
+						on:toggle={(event) =>
+							eesAction({
+								action: 'category',
+								category: id,
+								open: String(event.currentTarget.open)
+							})}
+					>
+						<summary aria-label={t(key, label)}
+							><Icon name={icon} /><span>{t(key, label)}</span></summary
+						>{#each current.filter((w) => w.category === id) as w}<button
+								data-action="workflow"
+								data-workflow-id={w.id}
+								aria-current={w.id === s.workflow_id ? 'page' : undefined}
+								on:click={() => eesAction({ action: 'workflow', workflowId: w.id })}
+								><span>{w.name}</span>{#if automatic[w.last_auto_status]}<span
+										class="ew-auto-status"
+										data-status={w.last_auto_status}
+										role="img"
+										aria-label={t('EES.Automatic.Last', 'Last automatic execution') +
+											' · ' +
+											t(automatic[w.last_auto_status][1], automatic[w.last_auto_status][2])}
+										title={t('EES.Automatic.Last', 'Last automatic execution') +
+											' · ' +
+											t(automatic[w.last_auto_status][1], automatic[w.last_auto_status][2])}
+										><Icon name={automatic[w.last_auto_status][0]} /></span
+									>{/if}</button
+							>{/each}
+					</details>{/each}
+				{#if !current.length}<p class="ew-empty">
+						{t('EES.NoProcedures', 'No procedures are registered.')}
+					</p>{/if}
+			</nav>
+		{/if}
+	{/if}
+	{#if $eesSnapshot.error}<p class="ew-error" role="alert">{$eesSnapshot.error}</p>
+		<button data-action="refresh" on:click={() => eesAction({ action: 'refresh' })}
+			>{t('EES.Retry', 'Check again')}</button
+		>{/if}
+</section>
