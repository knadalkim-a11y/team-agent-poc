+							aria-expanded={!$eesCompact && !s.collapsed?.includes(id)} aria-controls={`ees-category-${id}`}
+							on:click={() => {
+								const open = $eesCompact || s.collapsed?.includes(id);
+								if ($eesCompact) eesCompact.set(false);
+								eesAction({ action: 'category', category: id, open: String(Boolean(open)) });
+							}}><Icon name={icon} /><span>{t(key, label)}</span><Icon name="ead50" /></button>
+						<div class="ew-category-body" id={`ees-category-${id}`} inert={$eesCompact || s.collapsed?.includes(id)}
+							aria-hidden={$eesCompact || Boolean(s.collapsed?.includes(id))}><div class="ew-category-items">
+						{#each current.filter((w) => w.category === id) as w}<button
+								data-action="workflow"
+								data-workflow-id={w.id}
+								aria-current={w.id === s.workflow_id ? 'page' : undefined}
+								on:click={() => eesAction({ action: 'workflow', workflowId: w.id })}
+								><span>{w.name}</span>{#if automatic[w.last_auto_status]}<span
+										class="ew-auto-status"
+										data-status={w.last_auto_status}
+										role="img"
+										aria-label={t('EES.Automatic.Last', 'Last automatic execution') +
+											' · ' +
+											t(automatic[w.last_auto_status][1], automatic[w.last_auto_status][2])}
+										title={t('EES.Automatic.Last', 'Last automatic execution') +
+											' · ' +
+											t(automatic[w.last_auto_status][1], automatic[w.last_auto_status][2])}
+										><Icon name={automatic[w.last_auto_status][0]} /></span
+									>{/if}</button
+							>{/each}
+					</div></div></div>{/each}
+				{#if $eesSnapshot.scope_loading}<p class="ew-empty" role="status" data-ees-scope-loading="navigation">{t($eesSnapshot.error ? 'EES.ListUnavailable' : 'EES.Receiving', $eesSnapshot.error ? 'Could not receive the list.' : 'Receiving')}</p>
+				{:else if !current.length}<p class="ew-empty">
+						{t('EES.NoProcedures', 'No published procedures.')}
+					</p>{/if}
+			</nav>
+		{/if}
+	{/if}
+	{#if $eesSnapshot.error}<p class="ew-error" role="alert">{$eesSnapshot.error}</p>
+		<button data-action="refresh" on:click={() => eesAction({ action: 'refresh' })}
+			>{t('EES.Retry', 'Check again')}</button
+		>{/if}
+</section>
