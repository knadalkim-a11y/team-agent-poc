+						role="menuitem"
+						class="ees-asset-row"
+						data-action="native_open"
+						data-native-id={id}
+						aria-current={$eesSnapshot.native_id === id ? 'page' : undefined}
+						on:click={() => {
+							show = false;
+							eesAction({ action: 'native_open', nativeId: id });
+						}}
+					>
+						<Icon name={icon} /><span
+							><strong>{t(key, label)}</strong><small>{t(hintKey, hint)}</small></span
+						>
+					</button>
+				{/each}
+			</div>
+		</Dropdown>
+	</div>
+{/if}
