+<script lang="ts">
+	import { getContext } from 'svelte';
+	import { page } from '$app/stores';
+	import Dropdown from '../common/Dropdown.svelte';
+	import Icon from './EesIcon.svelte';
+	import { eesAction, eesSnapshot, eesCompact } from './state';
+	const i18n: any = getContext('i18n');
+	let show = false;
+	let previousBoundary = '';
+	const targets = [
+		[
+			'models',
+			'83565',
+			'EES.Nav.Models',
+			'AI assistant settings',
+			'EES.Settings.ModelsHint',
+			'Models, instructions and tools'
+		],
+		[
+			'admin',
+			'4308e',
+			'EES.Nav.Admin',
+			'Administrator settings',
+			'EES.Settings.AdminHint',
+			'Accounts and services'
+		]
+	];
+	$: cap = $eesSnapshot.native_capabilities ?? $eesSnapshot.state?.capabilities ?? {};
+	$: allowed = targets.filter(
+		([id]) =>
+			cap.native_access_available === true &&
+			cap.native_access?.[id] === true &&
+			(id !== 'admin' || cap.is_admin === true)
+	);
+	$: boundary = JSON.stringify([
+		$page.url.pathname,
+		$page.url.search,
+		cap.actor_id,
+		allowed.map(([id]) => id),
+		$eesCompact
+	]);
+	$: if (boundary !== previousBoundary) {
+		previousBoundary = boundary;
+		show = false;
+	}
+	$: t = (key, fallback) => $i18n.t(key, { defaultValue: fallback });
+</script>
+
+{#if allowed.length}
+	<div class="ees-settings-entry" data-ees-settings>
+		<Dropdown
+			bind:show
+			side="top"
+			align="start"
+			sideOffset={8}
+			contentClass="ees-assets-popover ees-settings-popover"
+			visualViewportAware
+		>
+			<button
+				type="button"
+				class="ees-settings-trigger"
+				data-ees-settings-current={$eesSnapshot.native_id}
+				aria-label={t('EES.Settings', 'Settings')}
+				aria-expanded={show}
+				aria-current={['models', 'admin'].includes($eesSnapshot.native_id) ? 'page' : undefined}
+				aria-haspopup="menu"
+				title={t('EES.Settings', 'Settings')}
+			>
+				<Icon name="4308e" /><span>{t('EES.Settings', 'Settings')}</span>
+			</button>
+			<div slot="content">
+				<h2>{t('EES.Settings', 'Settings')}</h2>
+				{#each allowed as [id, icon, key, label, hintKey, hint]}
+					<button
