diff --git a/src/lib/apis/ees-work.ts b/src/lib/apis/ees-work.ts
new file mode 100644
index 0000000..569b354
--- /dev/null
+++ b/src/lib/apis/ees-work.ts
@@ -0,0 +1,73 @@
+import { get } from 'svelte/store';
+import { user } from '$lib/stores';
+import { eesSessionReady } from '$lib/components/ees/state';
+import i18next from 'i18next';
+
+const message = (key: string, fallback: string) => i18next.t(key, { defaultValue: fallback });
+
+// Use the current Native session for every request. No EES credential copy is kept.
+export async function eesRequest(path: string, body?: unknown, signal?: AbortSignal) {
+	const actor = get(user)?.id;
+	const token = localStorage.token;
+	if (!actor || !token || !get(eesSessionReady))
+		throw Object.assign(new Error(message('EES.Api.SignIn', 'Sign in and try again.')), {
+			status: 401,
+			code: 'auth_required'
+		});
+	const assertOwner = () => {
+		if (!get(eesSessionReady) || get(user)?.id !== actor || localStorage.token !== token)
+			throw Object.assign(
+				new Error(
+					message('EES.Api.ContextChanged', 'Your session changed. Open this screen again.')
+				),
+				{ status: 409, code: 'context_changed' }
+			);
+	};
+	assertOwner();
+	const headers: Record<string, string> = {
+		Accept: 'application/json',
+		Authorization: 'Bearer ' + token
+	};
+	if (body) headers['Content-Type'] = 'application/json';
+	const response = await fetch('/api/ees-work/' + path, {
+		method: body ? 'POST' : 'GET',
+		credentials: 'same-origin',
+		cache: 'no-store',
+		headers,
+		...(body ? { body: JSON.stringify(body) } : {}),
+		...(signal ? { signal } : {})
+	});
+	assertOwner();
+	let result;
+	try {
+		result = await response.json();
+	} catch {
+		assertOwner();
+		throw Object.assign(
+			new Error(
+				message(
+					'EES.Api.InvalidResponse',
+					'The response could not be read. Check the saved or execution result again.'
+				)
+			),
+			{ status: response.status }
+		);
+	}
+	assertOwner();
+	if (!response.ok || result?.ok === false) {
+		const detail = result.error || result.detail || {};
+		throw Object.assign(
+			new Error(
+				detail.message ||
+					(typeof detail === 'string'
+						? detail
+						: message(
+								'EES.Api.RequestFailed',
+								'The request could not be completed. Check your permissions and input.'
+							))
+			),
+			{ status: response.status, code: detail.code, result }
+		);
+	}
+	return result;
+}
