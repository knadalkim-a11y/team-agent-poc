  {
    "type": "text",
    "text": "const assetPathPrefix = \"https://www.figma.com/api/mcp/asset/c742c528-a714-4b40-895b-9270ec86f9c4\";\nconst imgStateFailed = `${assetPathPrefix}/44a96.svg`;\nconst imgStateWaiting = `${assetPathPrefix}/40ef1.svg`;\nconst imgStateDone = `${assetPathPrefix}/d553d.svg`;\nconst imgStateUnknown = `${assetPathPrefix}/d448c.svg`;\nconst imgIconWrench = `${assetPathPrefix}/f1e53.svg`;\nconst imgIconUser = `${assetPathPrefix}/afcd5.svg`;\nconst imgIconCheck = `${assetPathPrefix}/52271.svg`;\nconst imgIconClock = `${assetPathPrefix}/63982.svg`;\n\ntype ButtonV4Props = {\n  className?: string;\n  label?: string;\n  style?: \"Secondary\" | \"Text\";\n};\n\nfunction ButtonV4({ className, label = \"버튼\", style = \"Secondary\" }: ButtonV4Props) {\n  const isText = style === \"Text\";\n  return (\n    <div className={className || `content-stretch flex h-[34px] items-center justify-center relative rounded-[6px] ${isText ? \"px-[6px]\" : \"bg-[var(--ees-surface-default,white)] border border-[var(--ees-line-control,#d5d6da)] border-solid px-[14px]\"}`} id={isText ? \"node-746_645\" : \"node-746_643\"}>\n      {style === \"Secondary\" && (\n        <p className=\"[word-break:break-word] font-['Noto_Sans_KR:Medium'] font-medium leading-[22px] relative shrink-0 text-[14px] text-[color:var(--ees-text-strong,#3f4147)] tracking-[-0.042px] whitespace-nowrap\" data-node-id=\"746:644\">\n          {label}\n        </p>\n      )}\n      {isText && (\n        <p className=\"[word-break:break-word] font-['Noto_Sans_KR:Medium'] font-medium leading-[22px] relative shrink-0 text-[14px] text-[color:var(--ees-brand-text,#2f5f98)] tracking-[-0.042px] whitespace-nowrap\" data-node-id=\"746:646\">\n          {label}\n        </p>\n      )}\n    </div>\n  );\n}\n\ntype StatusGlyphV4Props = {\n  className?: string;\n  state?: \"Failed\" | \"Waiting\" | \"Done\" | \"Unknown\";\n};\n\nfunction StatusGlyphV4({ className, state = \"Failed\" }: StatusGlyphV4Props) {\n  const isDone = state === \"Done\";\n  const isUnknown = state === \"Unknown\";\n  const isWaiting = state === \"Waiting\";\n  return (\n    <div className={className || \"relative size-[16px]\"} id={isUnknown ? \"node-746_639\" : isDone ? \"node-746_634\" : isWaiting ? \"node-746_630\" : \"node-746_623\"}>\n      <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={isUnknown ? imgStateUnknown : isDone ? imgStateDone : isWaiting ? imgStateWaiting : imgStateFailed} />\n    </div>\n  );\n}\n\nexport default function S1() {\n  return (\n    <div className=\"bg-[var(--ees-surface-sidebar,#fafafa)] border border-[var(--ees-line-divider,#e6e6e9)] border-solid content-stretch flex flex-col gap-[20px] items-start overflow-clip p-[32px] relative rounded-[8px] size-full\" data-node-id=\"944:1036\" data-name=\"S1 · 상태 모음: 정상이 아닐 때의 블록\">\n      <p className=\"[word-break:break-word] font-['Noto_Sans_KR:Medium'] font-medium leading-[16px] relative shrink-0 text-[12px] text-[color:var(--ees-status-attention,#a5630f)] whitespace-nowrap\" data-node-id=\"944:1037\">\n        규칙\n      </p>\n      <p className=\"[word-break:break-word] font-['Noto_Sans_KR:Bold'] font-bold leading-[28px] relative shrink-0 text-[20px] text-[color:var(--ees-text-primary,#1f2023)] tracking-[-0.2px] whitespace-nowrap\" data-node-id=\"944:1038\">\n        정상이 아닐 때의 블록 · 상태 모음\n      </p>\n      <p className=\"[word-break:break-word] font-['Noto_Sans_KR:Regular'] font-normal leading-[22px] min-w-full relative shrink-0 text-[14px] text-[color:var(--ees-text-secondary,#5c5e65)] tracking-[-0.042px] w-[min-content]\" data-node-id=\"944:1039\">\n        업무 패널에서 상태에 따라 바뀌는 부분만 모았습니다. 틀(헤더·회차 띠·작업 머리·탭)은 그대로입니다. 공통 원칙: 모르면 모른다고 표시하고(미확인), 이전 결과로 빈칸을 채우지 않으며, 변경 요청은 자동으로 다시 보내지 않습니다.\n      </p>\n      <div className=\"content-stretch flex gap-[24px] items-start overflow-clip relative shrink-0\" data-node-id=\"944:1040\" data-name=\"Cards\">\n        <div className=\"content-stretch flex flex-col gap-[10px] items-start overflow-clip relative shrink-0 w-[480px]\" data-node-id=\"944:1041\" data-name=\"State / EES 실행 요청 · 완료 보고 없음\">\n          <p className=\"[word-break:break-word] font-['Noto_Sans_KR:Bold'] font-bold leading-[20px] relative shrink-0 text-[14px] text-[color:var(--ees-text-primary,#1f2023)] tracking-[-0.07px] whitespace-nowrap\" data-node-id=\"944:1042\">\n            EES 실행 요청 · 완료 보고 없음\n          </p>\n          <p className=\"[word-break:break-word] font-['Noto_Sans_KR:Regular'] font-normal leading-[18px] min-w-full relative shrink-0 text-[12px] text-[color:var(--ees-text-secondary,#5c5e65)] w-[min-content]\" data-node-id=\"944:1043\">\n            언제 · 요청 후 정한 시간(10분) 안에 EES의 완료 보고가 없을 때\n          </p>\n          <div className=\"bg-[var(--ees-surface-default,white)] border border-[var(--ees-line-control,#d5d6da)] border-solid content-stretch flex flex-col gap-[12px] items-start overflow-clip p-[16px] relative rounded-[8px] shrink-0 w-full\" data-node-id=\"944:1044\" data-name=\"Panel block\">\n            <div className=\"content-stretch flex gap-[8px] items-center overflow-clip relative shrink-0 w-full\" data-node-id=\"944:1045\" data-name=\"Frame\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_KR:Bold'] font-bold leading-[20px] relative shrink-0 text-[14px] text-[color:var(--ees-text-primary,#1f2023)] tracking-[-0.07px] whitespace-nowrap\" data-node-id=\"944:1046\">\n                EES 실행 요청\n              </p>\n              <div className=\"bg-[var(--ees-surface-muted,#ececef)] content-stretch flex items-start overflow-clip px-[6px] py-px relative rounded-[4px] shrink-0\" data-node-id=\"944:1047\" data-name=\"Frame\">\n                <p className=\"[word-break:break-word] font-['Noto_Sans_KR:Medium'] font-medium leading-[16px] relative shrink-0 text-[12px] text-[color:var(--ees-text-strong,#3f4147)] whitespace-nowrap\" data-node-id=\"944:1048\">\n                  작업 번호 EES-58213\n                </p>\n              </div>\n   